# Copy to .env and fill in. .env is gitignored: it holds everything that identifies your deployment.
GCP_PROJECT=my-project
GCP_ACCOUNT=                    # optional: gcloud account to use, blank for the active one
REGION=us-central1             # Cloud Run function region
ZONE=us-central1-a             # VM zone
VM=wireguard
VPN_HOST=vpn.example.com        # DNS name clients connect to
CF_ZONE=                        # Cloudflare zone ID for VPN_HOST's domain
WG_CONF=~/.config/wireguard/wg0.conf   # this machine's WireGuard client config
